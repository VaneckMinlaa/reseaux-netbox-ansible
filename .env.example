# Copy to .env and fill values (never commit .env)

# NetBox (source of truth)
NETBOX_URL=http://192.168.1.50:8000
NETBOX_TOKEN=changeme_netbox_api_token

# Mode: netbox | demo
# demo = use data/demo_devices.yaml (no NetBox required)
SOURCE_MODE=demo

# Ansible network credentials (prefer Ansible Vault in real use)
ANSIBLE_NETWORK_USER=admin
ANSIBLE_NETWORK_PASSWORD=changeme
ANSIBLE_BECOME_PASSWORD=changeme

# Paths (optional overrides)
EXPECTED_DIR=configs/expected
RUNNING_DIR=configs/running
REPORTS_DIR=reports
TEMPLATES_DIR=templates
